<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower. PRIV-02: nothing is backed up. Synced sales are restored from Firestore
   by signing in again; the local Firestore cache (customer names), sign-in state and temporary
   PDFs must not be copied into a device backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
