<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 and higher. PRIV-02: neither cloud backup nor device-to-device transfer copies app
   data. Synced sales come back by signing in on the new phone. Changes that never synced are not
   recoverable this way, which the app warns about before sign-out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
